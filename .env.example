# Telegram Bot Token (from @BotFather)
BOT_TOKEN=your_telegram_bot_token_here

# Database Configuration (PostgreSQL/SQLite)
DATABASE_URL=sqlite+aiosqlite:///bot_database.db
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/mediabot

# Redis Configuration (for Queue and Caching)
REDIS_URL=redis://localhost:6379/0

# Instagram Pairing Configuration
INSTAGRAM_USERNAME=your_bot_instagram_username
INSTAGRAM_PASSWORD=your_bot_instagram_password

# Optional: Admin IDs (comma separated)
ADMIN_IDS=123456789,987654321
